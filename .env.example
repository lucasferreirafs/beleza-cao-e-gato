APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo
SESSION_SECURE=false

AUTH_BYPASS=true
AUTH_BYPASS_ROLE=client

DB_CONNECTION=pgsql
DB_HOST=host-do-projeto.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.referência-do-seu-projeto
DB_PASSWORD=substituir-pela-senha-do-banco-de-dados
DB_SSLMODE=require

# Storage: preencha com a URL HTTPS do projeto, sem /storage/v1 no final.
SUPABASE_URL=
# Chave anon do projeto, reservada para integrações com as políticas RLS.
# Os uploads PHP abaixo usam a service_role; não há fallback para anon.
SUPABASE_ANON_KEY=
# Chave service_role: exclusiva do servidor. Nunca enviar ao HTML/JS ou versionar.
# Usada para enviar, atualizar e assinar URLs nos buckets existentes img-user e img-pets.
SUPABASE_SERVICE_ROLE_KEY=

# E-mail transacional via API HTTPS da Brevo (porta 443; compatível com Render Free).
# Gere a chave em Brevo e mantenha-a somente nas variáveis de ambiente do servidor.
BREVO_API_KEY=
BREVO_TIMEOUT_SECONDS=10
# Remetente precisa estar validado/autenticado na conta Brevo.
MAIL_FROM=
MAIL_FROM_NAME="Beleza Cão&Gato"
# Opcional: endereço que receberá respostas.
MAIL_REPLY_TO=
