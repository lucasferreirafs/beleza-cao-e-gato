APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo
SESSION_SECURE=false

AUTH_BYPASS=true
AUTH_BYPASS_ROLE=client

DB_CONNECTION=pgsql
